{
  "name": "@ultimatelemon-eu/postbus",
  "version": "0.3.0",
  "description": "MCP server for managing multiple mailboxes (IMAP/SMTP, optionally the Gmail API).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node --eval \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "add-user": "tsx src/cli/add-user.ts",
    "list-users": "tsx src/cli/list-users.ts",
    "rotate-token": "tsx src/cli/rotate-token.ts",
    "remove-user": "tsx src/cli/remove-user.ts",
    "link-gmail": "tsx src/cli/link-gmail.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@googleapis/gmail": "^18.0.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@ultimatelemon-eu/crypto": "^1.1.0",
    "@ultimatelemon-eu/mcp-http": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.16",
    "nodemailer": "^9.0.5",
    "open": "^11.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@ultimatelemon-eu/eslint-config": "^1.1.1",
    "@ultimatelemon-eu/prettier-config": "^1.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.11"
  },
  "private": true
}
