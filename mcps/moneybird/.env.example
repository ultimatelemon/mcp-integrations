PORT=3000
# Mount path when a proxy forwards a sub-path unchanged, e.g. /moneybird. Empty serves /mcp.
BASE_PATH=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# OAuth sign-in, on when both client values are set. Register
# <PUBLIC_URL><BASE_PATH>/oauth/callback as the redirect URI in Moneybird.
MONEYBIRD_CLIENT_ID=
MONEYBIRD_CLIENT_SECRET=
# Public origin without a path, e.g. https://mcp.ultimatelemon.eu
PUBLIC_URL=
# 32 random bytes, base64 (openssl rand -base64 32). Seals the issued tokens.
ENCRYPTION_KEY=

# Defaults for every caller; each can override them with X-Moneybird-* headers.
MONEYBIRD_ALLOW_WRITE=false
MONEYBIRD_ALLOW_DELETE=false
# Comma-separated toolsets, "all" or "none". Essential tools and moneybird_api are always on.
MONEYBIRD_TOOLSETS=
MONEYBIRD_ADMINISTRATION_ID=
# IANA time zone sent with date-sensitive requests, e.g. Europe/Amsterdam.
MONEYBIRD_TIME_ZONE=
MONEYBIRD_REQUEST_TIMEOUT_MS=30000
MONEYBIRD_MAX_RETRIES=3
