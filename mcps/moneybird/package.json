{
  "name": "@ultimatelemon-eu/moneybird",
  "version": "0.1.0",
  "description": "MCP server for the Moneybird accounting API, where every caller brings their own API token.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/mcp-integrations.git",
    "directory": "mcps/moneybird"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:tools": "node scripts/generate-tool-docs.ts",
    "spec:refresh": "node scripts/refresh-spec.ts"
  },
  "prettier": "@ultimatelemon-eu/prettier-config",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@ultimatelemon-eu/mcp-http": "^2.2.0",
    "pino": "^10.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^24.19.2",
    "@ultimatelemon-eu/eslint-config": "^1.1.1",
    "@ultimatelemon-eu/prettier-config": "^1.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
