PORT=3000
# Mount path when a proxy forwards a sub-path unchanged, e.g. /broker. Empty serves /mcp.
BASE_PATH=
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Bearer tokens that may call the server, as label:token, comma-separated.
# One per client so each can be rotated on its own (openssl rand -hex 32).
# The label shows up in logs, the token never does.
AUTH_TOKENS=mike:replace-with-64-hex,owner:replace-with-64-hex

# IB Gateway on the internal Docker network. Never expose its port publicly.
# gnzsnz/ib-gateway: 4004 is the paper API, 4003 live.
IB_HOST=dealdome-ib-gateway-jykfo0
IB_PORT=4004
# Unique per API client on the gateway; another client with the same id
# takes the connection over.
IB_CLIENT_ID=17
# paper or live; must match the account below (paper accounts start with D).
IB_TRADING_MODE=paper
# The server refuses to serve data unless the gateway is logged in to exactly this account.
IB_EXPECTED_ACCOUNT=DUR369692

# Optional, seconds.
IB_CONNECT_TIMEOUT=10
IB_REQUEST_TIMEOUT=20
IB_RECONNECT_MAX_DELAY=60
