{
  "name": "@ultimatelemon-eu/mcp-gateway",
  "version": "0.1.0",
  "description": "OAuth gateway in front of self-hosted MCP servers: Zitadel sign-in per route, then a proxy to the server on the internal network.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatelemon/mcp-integrations.git",
    "directory": "mcps/gateway"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ultimatelemon-eu/mcp-http": "^2.6.0",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@ultimatelemon-eu/eslint-config": "^1.1.1",
    "@ultimatelemon-eu/prettier-config": "^1.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
