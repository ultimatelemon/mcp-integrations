PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Public origin without a path; each route's issuer is this plus its path.
PUBLIC_URL=https://mcp.ultimatelemon.eu
# 32 random bytes, base64 (openssl rand -base64 32). Seals the issued tokens;
# rotating it signs everyone out.
ENCRYPTION_KEY=

# One Zitadel OIDC app for every route (project "MCP"). Register
# <PUBLIC_URL><path>/oauth/callback per route as a redirect URI there.
GATEWAY_OIDC_ISSUER=https://id.ultimatelemon.eu
GATEWAY_OIDC_CLIENT_ID=
GATEWAY_OIDC_CLIENT_SECRET=

# Zitadel `sub` of the owner (subject "owner" in routes.yaml).
GATEWAY_OWNER_SUB=

# Route garmin: the bearer token the Taxuspt container requires.
GARMIN_MCP_HTTP_TOKEN=
# Local development only: overrides the route's upstream from routes.yaml.
# GARMIN_UPSTREAM_URL=http://localhost:8000/mcp
